# The demo stack: a second copy of the app with its own database, for trying
# features on mock data.
#
#   docker compose --env-file .env.demo up -d
#   docker compose --env-file .env.demo exec api python -m app.demo_data
#
# A different project name gives it its own containers and its own database
# volume, so nothing here can reach the real data.
COMPOSE_PROJECT_NAME=budgeting-demo
APP_PORT=8089
# Shows the "Demo data" badge, and lets app.demo_data wipe and refill the database.
DEMO=true
